root = true

[*]
end_of_line = LF
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C
[*.{c,h}]
indent_size = 4
indent_style = tab

# Makefile
[Makefile]
indent_style = tab
indent_size = 8

# Markdown
[*.md]
# So we can add actual tabs when pressing tab
indent_style = tab
indent_size = unset

# Shell
[*.{sh,bash}]
indent_style = tab
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2
